# ============================================
# AI Agent — Project-Specific Configuration
# Copy to .env and fill in values
# NEVER commit .env — only .env.example
# ============================================
#
# IMPORTANT: If a credential already works at the host/global level
# (e.g. Pi built-in Linear, gh CLI, glab CLI), do NOT duplicate it here.
# Only store project-specific identifiers and credentials NOT available globally.
#

# === Project Identity ===
PROJECT_NAME=              # Human-readable project name
PROJECT_SLUG=              # kebab-case slug

# === Linear (Project-Specific — NOT secrets) ===
LINEAR_TEAM_KEY=           # Team key (e.g. IKA, ENG) — which team this project uses
LINEAR_PROJECT_ID=         # Linear project UUID (auto-filled on onboarding)
LINEAR_PROJECT_NAME=       # Project name as it appears in Linear
# LINEAR_API_KEY          → NOT NEEDED if host has Pi built-in Linear integration

# === Git (Project-Specific) ===
GIT_PROVIDER=              # github / gitlab / self-hosted
GIT_REPO_URL=              # e.g. git@gitlab.com:org/repo.git
GIT_REPO_SLUG=             # e.g. org/repo
# GITHUB_TOKEN            → NOT NEEDED if `gh auth status` succeeds
# GITLAB_TOKEN            → NOT NEEDED if `glab auth status` succeeds

# === Database (Project-Specific) ===
DATABASE_URL=              # Local dev DB connection string
DB_NAME=                   # Database name
DB_USER=                   # Database user
DB_PASS=                   # Database password (local dev only)

# === Only if NOT available at host level ===
# Uncomment and fill ONLY if host doesn't provide these:
#
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# CF_API_TOKEN=
# CF_ACCOUNT_ID=
# VERCEL_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
